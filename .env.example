# --- Environment paths for the project ---
PARQUETS_PATH="dataset/parquets"

# --- Environment variables for the local database ---
LOCAL_HOST="localhost"
LOCAL_PORT="5432"
LOCAL_USER="your_username"
LOCAL_PASSWORD="your_password"
LOCAL_DB="database_name"
LOCAL_URL="path/to/local/database.db"

# --- Environment variables for the Render database ---
RENDER_USER="render_username"
RENDER_PASSWORD="render_password"
RENDER_URL="url/to/render/database.db"
